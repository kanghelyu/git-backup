# 安装到 ~/.config/systemd/user/git-backup.timer
# 默认每 5 小时一次；想改节奏就调 OnBootSec / OnUnitActiveSec。
# Install to: ~/.config/systemd/user/git-backup.timer

[Unit]
Description=Git one-click backup every five hours

[Timer]
OnBootSec=5min
OnUnitActiveSec=5h
AccuracySec=1min
Unit=git-backup.service

[Install]
WantedBy=timers.target
